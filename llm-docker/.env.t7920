# LLM Docker Environment Configuration -- Dell Precision T7920 (shared host)
#
# Copied to .env by scripts/setup-t7920.sh. The T5820 reference values live in .env;
# this file is the T7920's answer to the same questions. The machine is shared with
# other Docker stacks; RESERVED_PORTS lists what they already own so nothing here
# lands on them (scripts/setup-t7920.sh warns if a port is taken).

# Compose: base + T7920 override (cold-tier mount, keep-alive) + speech + web UI.
# These all autostart with the stack and hold no VRAM until used. Forge (image
# generation) is NOT in this list: it is a 10 GB VRAM commitment, start it on demand
# with scripts/start-forge.sh. vLLM is opt-in and cannot share the card with the rest.
COMPOSE_FILE=docker-compose.yml:docker-compose.t7920.yml:docker-compose.speech.yml:docker-compose.webui.yml

# Storage Paths
#   MODELS_PATH       hot tier, OS NVMe (~300 GB budget; shared with Docker images)
#   COLD_MODELS_PATH  cold tier, 8 TB HDD; scripts/ollama-tier.sh moves blobs between them
#   DATA_PATH         working data on the HDD: logs, benchmarks, datasets, tier ledger
MODELS_PATH=/srv/llm-models
COLD_MODELS_PATH=/mnt/data/llm-models
DATA_PATH=/mnt/data/llm-data

# Ollama Configuration
OLLAMA_MODELS=${MODELS_PATH}/ollama
OLLAMA_PORT=11434
# How long a loaded model stays resident after its last request. The box is powered
# off overnight, so the first load each day is the expensive one; 30m keeps a model
# warm across a working session without holding VRAM for nothing all day.
OLLAMA_KEEP_ALIVE=30m

# vLLM Configuration
VLLM_CACHE=${MODELS_PATH}/vllm
VLLM_PORT=8000
VLLM_API_KEY=your-vllm-api-key-here

# Text Generation Inference Configuration
TGI_CACHE=${MODELS_PATH}/tgi
# 8080 belongs to another tenant on this host
TGI_PORT=8081

# Ports owned by other stacks on this machine (informational; checked by setup)
RESERVED_PORTS="8080 8085 9000 9001 3000 9090"

# Stable Diffusion Forge Configuration
FORGE_PORT=7860
FORGE_ARGS="--always-offload-from-vram --pin-shared-memory"

# Speech (docker-compose.speech.yml)
# 9000 is taken by another tenant on this host (upstream whisper default)
WHISPER_PORT=9200
WHISPER_MODEL=large-v3-turbo
TTS_PORT=8880

# Open WebUI (docker-compose.webui.yml) -- upstream default 8080 is taken on this host
WEBUI_PORT=8082

# GPU Configuration
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_UTILIZATION=0.90

# Logging
LOG_LEVEL=INFO
LOG_PATH=${DATA_PATH}/logs
