# LLM Docker Environment Configuration -- Dell Precision T7920 ("Staging-Server")
#
# Copied to .env by scripts/setup-t7920.sh. The T5820 reference values live in .env;
# this file is the T7920's answer to the same questions. Shared host: CurvAero's
# staging stack owns 8080/8085/9000/9001/3000/9090 on this machine.

# Compose: the base file plus the T7920 override (cold-tier mount, keep-alive)
COMPOSE_FILE=docker-compose.yml:docker-compose.t7920.yml

# Storage Paths
#   MODELS_PATH       hot tier, OS NVMe (~300 GB budget; shared with Docker images)
#   COLD_MODELS_PATH  cold tier, 8 TB HDD; scripts/ollama-tier.sh moves blobs between them
#   DATA_PATH         working data on the HDD: logs, benchmarks, datasets, tier ledger
MODELS_PATH=/srv/llm-models
COLD_MODELS_PATH=/mnt/data/llm-models
DATA_PATH=/mnt/data/llm-data

# Ollama Configuration
OLLAMA_MODELS=${MODELS_PATH}/ollama
OLLAMA_PORT=11434
# How long a loaded model stays resident after its last request. The box is powered
# off overnight, so the first load each day is the expensive one; 30m keeps a model
# warm across a working session without holding VRAM for nothing all day.
OLLAMA_KEEP_ALIVE=30m

# vLLM Configuration
VLLM_CACHE=${MODELS_PATH}/vllm
VLLM_PORT=8000
VLLM_API_KEY=your-vllm-api-key-here

# Text Generation Inference Configuration
TGI_CACHE=${MODELS_PATH}/tgi
# 8080 is CurvAero's API gateway on this host
TGI_PORT=8081

# Stable Diffusion Forge Configuration
FORGE_PORT=7860
FORGE_ARGS=--always-offload-from-vram --pin-shared-memory

# GPU Configuration
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_UTILIZATION=0.90

# Logging
LOG_LEVEL=INFO
LOG_PATH=${DATA_PATH}/logs
